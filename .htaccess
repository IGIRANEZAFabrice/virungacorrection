<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host on production; local development remains accessible.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?virungajourneys\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://virungajourneys.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+[^?\s]*home/?[?\s] [NC]
  RewriteRule ^home/?$ ./ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.php/?[?\s] [NC]
  RewriteRule ^index\.php/?$ ./ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*journeys/?[?\s] [NC]
  RewriteRule ^journeys/?$ experiences [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*stays/?[?\s] [NC]
  RewriteRule ^stays/?$ homestays [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*faqs/?[?\s] [NC]
  RewriteRule ^faqs/?$ faq [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*cancelation\-policy/?[?\s] [NC]
  RewriteRule ^cancelation\-policy/?$ cancellation-policy [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*cars/?[?\s] [NC]
  RewriteRule ^cars/?$ carrent [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*activities/?[?\s] [NC]
  RewriteRule ^activities/?$ activity [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*blogs/?[?\s] [NC]
  RewriteRule ^blogs/?$ blog [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*rules/?[?\s] [NC]
  RewriteRule ^rules/?$ houserules [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/?[?\s] [NC]
  RewriteRule ^homestay/?$ homestays [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/index\.php/?[?\s] [NC]
  RewriteRule ^homestay/index\.php/?$ homestays [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*ecotours/?[?\s] [NC]
  RewriteRule ^ecotours/?$ experiences [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*ecotours/index\.php/?[?\s] [NC]
  RewriteRule ^ecotours/index\.php/?$ experiences [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*ecotours/pages/coffee\.php/?[?\s] [NC]
  RewriteRule ^ecotours/pages/coffee\.php/?$ coffee [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*pages/about\.php/?[?\s] [NC]
  RewriteRule ^pages/about\.php/?$ about [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*pages/cancellation\-policy\.php/?[?\s] [NC]
  RewriteRule ^pages/cancellation\-policy\.php/?$ cancellation-policy [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*pages/contact\.php/?[?\s] [NC]
  RewriteRule ^pages/contact\.php/?$ contact-us [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*pages/destinations\.php/?[?\s] [NC]
  RewriteRule ^pages/destinations\.php/?$ destinations [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*pages/faq\.php/?[?\s] [NC]
  RewriteRule ^pages/faq\.php/?$ faq [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*pages/home\.php/?[?\s] [NC]
  RewriteRule ^pages/home\.php/?$ ./ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*pages/membership\.php/?[?\s] [NC]
  RewriteRule ^pages/membership\.php/?$ membership [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*pages/short\-encounters\.php/?[?\s] [NC]
  RewriteRule ^pages/short\-encounters\.php/?$ short-encounters [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/home/?[?\s] [NC]
  RewriteRule ^homestay/home/?$ homestays [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/home\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/home\.php/?$ homestays [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/homestays/?[?\s] [NC]
  RewriteRule ^homestay/homestays/?$ homestays [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/stays/?[?\s] [NC]
  RewriteRule ^homestay/stays/?$ homestays [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/about\-us/?[?\s] [NC]
  RewriteRule ^homestay/about\-us/?$ about-us [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/about\-us\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/about\-us\.php/?$ about-us [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/rooms/?[?\s] [NC]
  RewriteRule ^homestay/rooms/?$ rooms [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/rooms\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/rooms\.php/?$ rooms [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/houserules/?[?\s] [NC]
  RewriteRule ^homestay/houserules/?$ houserules [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/houserules\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/houserules\.php/?$ houserules [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/shop/?[?\s] [NC]
  RewriteRule ^homestay/shop/?$ shop [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/shop\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/shop\.php/?$ shop [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/contact/?[?\s] [NC]
  RewriteRule ^homestay/contact/?$ contact [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/contact\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/contact\.php/?$ contact [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/carrent/?[?\s] [NC]
  RewriteRule ^homestay/carrent/?$ carrent [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/carrent\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/carrent\.php/?$ carrent [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/cars/?[?\s] [NC]
  RewriteRule ^homestay/cars/?$ carrent [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/activity/?[?\s] [NC]
  RewriteRule ^homestay/activity/?$ activity [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/activity\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/activity\.php/?$ activity [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/activities/?[?\s] [NC]
  RewriteRule ^homestay/activities/?$ activity [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/blog/?[?\s] [NC]
  RewriteRule ^homestay/blog/?$ blog [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/blog\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/blog\.php/?$ blog [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/blogs/?[?\s] [NC]
  RewriteRule ^homestay/blogs/?$ blog [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/blogdetails/?[?\s] [NC]
  RewriteRule ^homestay/blogdetails/?$ blogdetails [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/blogdetails\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/blogdetails\.php/?$ blogdetails [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/activitydetails/?[?\s] [NC]
  RewriteRule ^homestay/activitydetails/?$ activitydetails [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/activitydetails\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/activitydetails\.php/?$ activitydetails [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/bookinginfo/?[?\s] [NC]
  RewriteRule ^homestay/bookinginfo/?$ bookinginfo [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/bookinginfo\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/bookinginfo\.php/?$ bookinginfo [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/rules/?[?\s] [NC]
  RewriteRule ^homestay/rules/?$ houserules [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/impact/?[?\s] [NC]
  RewriteRule ^homestay/impact/?$ impact [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/impact\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/impact\.php/?$ impact [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/safety/?[?\s] [NC]
  RewriteRule ^homestay/safety/?$ safety [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*homestay/pages/safety\.php/?[?\s] [NC]
  RewriteRule ^homestay/pages/safety\.php/?$ safety [R=301,L]

  # Clean public routes use no trailing slash.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ $1 [R=301,L]


  # Route everything not matching a real file/folder to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# ---------- GZIP & BROTLI COMPRESSION ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- BROWSER CACHING (MOD_EXPIRES) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Vector
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS & JS
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# ---------- SECURITY & PERFORMANCE HEADERS ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Cache Control Headers
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|css|js|woff2?)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>

# Blog HTML changes whenever an article or its images are updated.
<FilesMatch "^(blog|blogopen|load_more_posts)\.php$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header unset Cache-Control
    Header unset Expires
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
  </IfModule>
</FilesMatch>
